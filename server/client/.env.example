# Copy to .env (or .env.production) and fill in what you use. Everything is optional.

# Street map style. Default is OpenFreeMap (free, no key). Examples:
#   MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
#   Stadia:   https://tiles.stadiamaps.com/styles/osm_bright.json?api_key=YOUR_KEY
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Satellite imagery. Default: Esri World Imagery (no key). For a large public launch use a keyed provider, e.g.:
# VITE_SATELLITE_TILES=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# VITE_SATELLITE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# Use "off" to hide the satellite buttons entirely:
# VITE_SATELLITE_TILES=off

# Error reporting (Sentry). Leave empty to turn it off.
# VITE_SENTRY_DSN=
# VITE_RELEASE=1.0.0

# Only for the Android/iOS app build: the public address of your server (no trailing slash).
# VITE_SERVER_URL=https://api.your-domain.com

# Only for `npm run dev`: where your Node server is running.
# DEV_SERVER_URL=http://localhost:3001
